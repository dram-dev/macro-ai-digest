<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dr.digest.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>digest</string>
        <string>pipeline</string>
        <string>--run-type</string>
        <string>daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_PATH__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/dramsey/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/usr/sbin:/sbin:/bin</string>
    </dict>

    <!-- The one run a day, first in the overnight sequence. pc-insurance-digest
         fires at 01:05 and blocks on the shared cross-digest pipeline lock
         (/tmp/digest-pipeline.lock) until this run finishes, so the two never
         share Ollama/MLX at once. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>1</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__PROJECT_PATH__/logs/daily.out.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_PATH__/logs/daily.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
